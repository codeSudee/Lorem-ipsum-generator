---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Generator from "../components/Generator.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { LANDING_PAGES, getLandingPage } from "../lib/landingPages";

export function getStaticPaths() {
	return LANDING_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const related = page.related.map((slug) => getLandingPage(slug)).filter((p) => p !== undefined);
const pageURL = new URL(`/${page.slug}`, Astro.site).toString();

const webPageData = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: page.h1,
	url: pageURL,
	description: page.description,
	dateModified: page.updated,
	isPartOf: { "@type": "WebSite", name: "Lorem Ipsum Generator", url: Astro.site?.toString() },
};
---

<Layout
	title={page.title}
	description={page.description}
	faqs={page.faqs}
	breadcrumbs={[{ name: page.label, path: `/${page.slug}` }]}
>
	<script slot="structured-data" type="application/ld+json" set:html={JSON.stringify(webPageData)} />
	<Navbar />
	<main id="main-content">
		<section class="border-b border-hairline bg-canvas pt-20 pb-4 sm:pt-28">
			<div class="mx-auto max-w-[800px] px-6 text-center">
				<p class="mono-eyebrow mb-3 text-mute">{page.eyebrow}</p>
				<h1 class="text-heading-lg text-pretty text-ink sm:text-display-xl">{page.h1}</h1>
				<p class="mx-auto mt-5 max-w-2xl text-pretty text-body-lg text-body">{page.intro}</p>
			</div>
		</section>

		<Generator preset={page.preset} />

		<section class="border-b border-hairline bg-canvas py-20 sm:py-28">
			<div class="mx-auto max-w-[800px] px-6">
				<div class="flex flex-col gap-6 text-body-md text-body">
					{page.sections.map((section) => (
						<>
							<h2 class="text-heading-lg text-pretty text-ink">{section.heading}</h2>
							{section.paragraphs.map((text) => <p>{text}</p>)}
						</>
					))}
				</div>
			</div>
		</section>

		<FAQ items={page.faqs} eyebrow="Common questions" />

		<section class="border-b border-hairline bg-canvas py-16">
			<div class="mx-auto max-w-[800px] px-6">
				<h2 class="text-heading-md text-ink">Related generators</h2>
				<ul class="mt-4 flex flex-wrap gap-3">
					{related.map((r) => (
						<li>
							<a
								href={`/${r.slug}`}
								class="rounded-pill border border-hairline bg-canvas-elevated px-[14px] py-2.5 text-button-lg font-medium text-ink transition-colors hover:bg-hairline-soft"
							>
								{r.label}
							</a>
						</li>
					))}
					<li>
						<a
							href="/"
							class="rounded-pill border border-hairline bg-canvas-elevated px-[14px] py-2.5 text-button-lg font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							All options
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
