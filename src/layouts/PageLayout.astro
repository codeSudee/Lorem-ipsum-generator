---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	heading: string;
	updated?: string;
	/** Optional page-specific JSON-LD object(s), rendered into Layout's structured-data slot. */
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, eyebrow, heading, updated, structuredData } = Astro.props;
const structuredDataList = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
---

<Layout title={title} description={description}>
	{structuredDataList.map((data) => (
		<script slot="structured-data" type="application/ld+json" set:html={JSON.stringify(data)} />
	))}
	<Navbar />
	<main id="main-content">
		<section class="border-b border-hairline bg-canvas py-20 sm:py-28">
			<div class="mx-auto max-w-[800px] px-6">
				<p class="mono-eyebrow mb-3 text-mute">{eyebrow}</p>
				<h1 class="text-heading-lg text-pretty text-ink">{heading}</h1>
				{updated && <p class="mt-3 text-body-sm text-mute">Last updated: {updated}</p>}

				<div class="prose-content mt-10 flex flex-col gap-6 text-body-md text-body">
					<slot />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.prose-content :global(h2) {
		margin-top: 0.5rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-ink, inherit);
		line-height: 1.3;
	}

	.prose-content :global(ul) {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.prose-content :global(a:not(.rounded-pill)) {
		color: var(--color-ink, inherit);
		text-decoration: underline;
		text-decoration-color: var(--color-hairline, currentColor);
		text-underline-offset: 2px;
	}

	.prose-content :global(a:not(.rounded-pill):hover) {
		opacity: 0.8;
	}
</style>
