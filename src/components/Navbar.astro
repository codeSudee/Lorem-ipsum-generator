---
const navLinks = [
	{ href: "/#generator", label: "Generator" },
	{ href: "/#themes", label: "Themes" },
	{ href: "/#faq", label: "FAQ" },
	{ href: "/about", label: "About" },
];
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/90 backdrop-blur-sm">
	<nav
		class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-3"
		aria-label="Primary"
	>
		<a
			href="/"
			class="flex items-center gap-2 rounded-sm text-label-sm text-ink"
			aria-label="Lorem Ipsum Generator home"
		>
			<span
				class="flex h-7 w-7 items-center justify-center rounded-sm bg-ink text-on-primary"
				aria-hidden="true"
			>
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M8 1L15 14H1L8 1Z" fill="currentColor" />
				</svg>
			</span>
			<span class="font-semibold">Lorem Ipsum Generator</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			{navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="rounded-full px-3 py-2 text-body-md text-body transition-colors hover:bg-hairline-soft hover:text-ink"
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-2">
			<button
				type="button"
				id="theme-toggle"
				class="flex h-8 w-8 items-center justify-center rounded-sm border border-hairline bg-canvas-elevated text-ink transition-colors hover:bg-hairline-soft"
				aria-label="Switch to dark mode"
				aria-pressed="false"
			>
				<svg
					id="theme-toggle-icon-light"
					width="16"
					height="16"
					viewBox="0 0 16 16"
					fill="none"
					aria-hidden="true"
					class="block dark:hidden"
				>
					<circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1.3" />
					<path
						d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.7 3.3l-1.1 1.1M4.4 11.6l-1.1 1.1M12.7 12.7l-1.1-1.1M4.4 4.4L3.3 3.3"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
					/>
				</svg>
				<svg
					id="theme-toggle-icon-dark"
					width="16"
					height="16"
					viewBox="0 0 16 16"
					fill="none"
					aria-hidden="true"
					class="hidden dark:block"
				>
					<path
						d="M14 9.5A6 6 0 1 1 6.5 2a4.7 4.7 0 0 0 7.5 7.5Z"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linejoin="round"
					/>
				</svg>
			</button>
			<a
				href="/#generator"
				class="rounded-sm bg-ink px-3 py-1.5 text-button-md font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				Generate Text
			</a>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById("theme-toggle") as HTMLButtonElement;

	function applyTheme(isDark: boolean) {
		document.documentElement.classList.toggle("dark", isDark);
		toggle.setAttribute("aria-pressed", String(isDark));
		toggle.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
	}

	// Sync the toggle's a11y state with whatever the no-flash init script set.
	applyTheme(document.documentElement.classList.contains("dark"));

	toggle.addEventListener("click", () => {
		const isDark = !document.documentElement.classList.contains("dark");
		localStorage.setItem("theme", isDark ? "dark" : "light");
		applyTheme(isDark);
	});
</script>
