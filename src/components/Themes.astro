---
import { THEME_LIST } from "../lib/wordBanks";

const swatches: Record<string, string> = {
	classic: "bg-hairline-soft",
	corporate: "bg-link-soft",
	tech: "bg-cyan-soft",
	foodie: "bg-warning-soft",
	cat: "bg-violet-soft",
	funny: "bg-magenta/30",
};
---

<section id="themes" class="border-b border-hairline bg-canvas py-20 sm:py-28">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="mx-auto mb-10 max-w-2xl text-center">
			<p class="mono-eyebrow mb-3 text-mute">Themed vocabularies</p>
			<h2 class="text-heading-lg text-pretty text-ink">More than Latin</h2>
			<p class="mt-3 text-body-lg text-body">
				Six distinct word banks so your mockups sound like your product, not a
				2,000-year-old treatise on ethics.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
			{THEME_LIST.map((theme) => (
				<div class="rounded-md border border-hairline bg-canvas-elevated p-5">
					<div class={`mb-4 h-8 w-8 rounded-sm ${swatches[theme.key] ?? "bg-hairline-soft"}`} aria-hidden="true"></div>
					<h3 class="text-heading-md text-ink">{theme.label}</h3>
					<p class="mt-2 text-body-sm text-body">{theme.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
