---
const year = new Date().getFullYear();

const columns = [
	{
		heading: "Product",
		links: [
			{ label: "Generator", href: "/#generator" },
			{ label: "Themes", href: "/#themes" },
			{ label: "FAQ", href: "/#faq" },
		],
	},
	{
		heading: "Formats",
		links: [
			{ label: "Plain Text", href: "/#generator" },
			{ label: "HTML", href: "/#generator" },
			{ label: "Markdown", href: "/#generator" },
		],
	},
	{
		heading: "Company",
		links: [
			{ label: "About", href: "/about" },
			{ label: "Contact", href: "/contact" },
		],
	},
	{
		heading: "Legal",
		links: [
			{ label: "Privacy Policy", href: "/privacy-policy" },
			{ label: "Terms & Conditions", href: "/terms" },
		],
	},
];
---

<footer class="bg-canvas py-16">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
			<div class="col-span-2 sm:col-span-1">
				<a href="/" class="flex items-center gap-2 text-label-sm text-ink" aria-label="Lorem Ipsum Generator home">
					<span class="flex h-7 w-7 items-center justify-center rounded-sm bg-ink text-on-primary" aria-hidden="true">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M8 1L15 14H1L8 1Z" fill="currentColor" />
						</svg>
					</span>
					<span class="font-semibold">Lorem Ipsum Generator</span>
				</a>
				<p class="mt-3 text-body-sm text-mute">
					Instant Latin &amp; themed placeholder text for designers and developers.
				</p>
			</div>

			{columns.map((col) => (
				<div>
					<h3 class="mono-eyebrow mb-3 text-faint">{col.heading}</h3>
					<ul class="flex flex-col gap-2">
						{col.links.map((link) => (
							<li>
								<a href={link.href} class="text-body-sm text-body transition-colors hover:text-ink">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-hairline pt-6 text-body-sm text-mute sm:flex-row">
			<p>&copy; {year} Lorem Ipsum Generator. All rights reserved.</p>
		</div>
	</div>
</footer>
