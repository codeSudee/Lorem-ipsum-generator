---
const standardPassage = `Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.`;
---

<section class="border-b border-hairline bg-canvas py-20 sm:py-28">
	<div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-12 px-6 lg:grid-cols-2">
		<div>
			<p class="mono-eyebrow mb-3 text-mute">Where it comes from</p>
			<h2 class="text-heading-lg text-pretty text-ink">
				2,000 years old, still the industry standard
			</h2>
			<p class="mt-4 text-body-md text-body">
				Lorem Ipsum isn't random text — it's a scrambled excerpt from
				Cicero's <em>“de Finibus Bonorum et Malorum”</em>, written in 45 BC.
				Typesetters adopted it in the 1960s for its natural letter
				distribution, and it's been the default filler text of the printing
				and web industries ever since.
			</p>
			<p class="mt-4 text-body-md text-body">
				Lorem Ipsum Generator generates fresh passages from a 150-word Latin bank
				combined with model sentence structures, so you get text that
				reads naturally without repeating the same fixed block every time.
				Dial in a precise character count, generate a themed paragraph instead
				of Latin, and copy the result in one click.
			</p>
		</div>

		<div class="rounded-md border border-hairline bg-canvas-elevated p-6">
			<p class="mono-eyebrow mb-4 text-mute">The standard passage, since 1966</p>
			<p class="font-mono text-code text-ink">{standardPassage}</p>
		</div>
	</div>
</section>
