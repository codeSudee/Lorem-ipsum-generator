---
import { THEME_LIST } from "../lib/wordBanks";

// Default theme on first load: real English vocabulary rather than Latin or
// nonsense words, so the first visible output is readable language.
const DEFAULT_THEME = "tech";
const SAMPLE_OUTPUT =
	"Our startup is disrupting the platform with a scalable product roadmap. The team ships every sprint, tracks growth metrics on a shared dashboard, and iterates on user feedback after each launch.";
---

<section id="generator" class="border-b border-hairline bg-canvas py-20 sm:py-28">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="mx-auto mb-10 max-w-2xl text-center">
			<p class="mono-eyebrow mb-3 text-mute">The generator</p>
			<h2 class="text-heading-lg text-pretty text-ink">Configure and generate</h2>
			<p class="mt-3 text-body-lg text-body">
				Set the amount and hit Generate — or open "More options" to pick a
				theme and export format.
			</p>
		</div>

		<div
			id="lorem-generator"
			class="rounded-lg border border-hairline bg-canvas-elevated p-5 sm:p-8"
		>
			<form id="generator-form">
				<div class="grid gap-8 lg:grid-cols-[minmax(0,320px)_1fr]">
					<!-- Controls -->
					<div class="flex flex-col gap-6">
						<!-- Primary row: amount + unit + generate. This is the one decision
						     a first-time visitor needs to make; everything else is secondary
						     and lives behind the "More options" disclosure below. -->
						<div>
							<label for="amount-input" class="mb-2 block text-label-sm font-medium text-ink">
								Amount
							</label>
							<div class="flex gap-2">
								<input
									type="number"
									id="amount-input"
									name="amount"
									min="1"
									max="50"
									value="5"
									inputmode="numeric"
									autocomplete="off"
									class="w-20 rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-body-md text-ink tabular-nums focus-visible:outline-2 focus-visible:outline-link"
								/>
								<div id="unit-dropdown" class="relative flex-1">
									<button
										type="button"
										id="unit-select-trigger"
										aria-haspopup="listbox"
										aria-expanded="false"
										aria-controls="unit-select-listbox"
										class="flex w-full items-center justify-between rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-body-md text-ink focus-visible:outline-2 focus-visible:outline-link"
									>
										<span id="unit-select-label">Paragraphs</span>
										<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-mute">
											<path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</button>
									<ul
										id="unit-select-listbox"
										role="listbox"
										tabindex="-1"
										aria-label="Amount unit"
										aria-activedescendant=""
										hidden
										class="absolute inset-x-0 top-full z-10 mt-1 overflow-hidden rounded-sm border border-hairline bg-canvas-elevated shadow-lg"
									>
										<li role="option" id="unit-option-paragraphs" data-value="paragraphs" aria-selected="true" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Paragraphs</li>
										<li role="option" id="unit-option-sentences" data-value="sentences" aria-selected="false" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Sentences</li>
										<li role="option" id="unit-option-words" data-value="words" aria-selected="false" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Words</li>
										<li role="option" id="unit-option-characters" data-value="characters" aria-selected="false" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Characters</li>
										<li role="option" id="unit-option-titles" data-value="titles" aria-selected="false" class="cursor-pointer border-t border-hairline px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Titles</li>
										<li role="option" id="unit-option-captions" data-value="captions" aria-selected="false" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Captions</li>
										<li role="option" id="unit-option-names" data-value="names" aria-selected="false" class="cursor-pointer px-3 py-2 text-body-md text-ink aria-selected:bg-ink aria-selected:text-on-primary hover:bg-hairline-soft">Names</li>
									</ul>
									<input type="hidden" id="unit-select" name="unit" value="paragraphs" />
								</div>
							</div>
							<p class="mt-2 text-body-sm text-mute" id="amount-status" aria-live="polite"></p>
						</div>

						<button
							type="submit"
							class="flex items-center justify-center gap-2 rounded-sm bg-ink px-4 py-2.5 text-button-lg font-medium text-on-primary transition-opacity hover:opacity-90"
						>
							Generate
							<kbd class="rounded-xs border border-on-primary/20 bg-on-primary/10 px-1.5 py-0.5 text-body-sm font-normal" aria-hidden="true">
								&#8984;&#8617;
							</kbd>
						</button>

						<!-- Secondary controls: theme, standard-opener toggle, export format.
						     Collapsed by default so a first-time visitor sees one clear
						     decision (amount + unit) instead of seven at once; a returning
						     or detail-oriented user can expand for full control. -->
						<details id="more-options" class="group rounded-sm border border-hairline">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2.5 text-label-sm font-medium text-ink marker:content-none">
								More options
								<span
									class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-hairline text-body-sm text-mute transition-transform group-open:rotate-45"
									aria-hidden="true"
								>
									+
								</span>
							</summary>

							<div class="flex flex-col gap-6 border-t border-hairline p-3 pt-4">
								<!-- Theme selector -->
								<fieldset>
									<legend class="mb-2 block text-label-sm font-medium text-ink">Theme</legend>
									<div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Word bank theme">
										{THEME_LIST.map((theme, i) => (
											<label
												class="theme-option flex cursor-pointer items-center justify-center rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-center text-body-sm text-body transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-on-primary hover:border-faint"
											>
												<input
													type="radio"
													name="theme"
													value={theme.key}
													checked={theme.key === DEFAULT_THEME}
													class="sr-only"
												/>
												{theme.label}
											</label>
										))}
										<label
											class="theme-option col-span-2 flex cursor-pointer items-center justify-center rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-center text-body-sm text-body transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-on-primary hover:border-faint"
										>
											<input type="radio" name="theme" value="custom" class="sr-only" />
											Custom — use your own text
										</label>
									</div>

									<!-- Custom word bank source. Shown only while the Custom theme is
									     selected; words are extracted from this passage and fed through
									     the same sentence/paragraph builders as the built-in banks. -->
									<div id="custom-text-field" class="mt-3" hidden>
										<label for="custom-text" class="mb-2 block text-label-sm font-medium text-ink">
											Your text
										</label>
										<textarea
											id="custom-text"
											name="customText"
											rows="5"
											maxlength="20000"
											spellcheck="false"
											placeholder="Paste a poem, song lyric, or any passage…"
											aria-describedby="custom-text-hint"
											class="w-full resize-y rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-body-md text-ink placeholder:text-faint focus-visible:outline-2 focus-visible:outline-link"
										></textarea>
										<p id="custom-text-hint" class="mt-2 text-body-sm text-mute" aria-live="polite">
											Words are shuffled into new sentences — your text is never
											repeated verbatim. Needs at least 10 different words.
										</p>
									</div>
								</fieldset>

								<!-- Start with lorem toggle -->
								<div>
									<label class="flex cursor-pointer items-center justify-between gap-3 rounded-sm border border-hairline px-3 py-2.5">
										<span class="text-body-md text-ink">Start with the standard opener</span>
										<input
											type="checkbox"
											id="start-with-lorem"
											name="startWithLorem"
											checked
											class="h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-hairline transition-colors before:block before:h-4 before:w-4 before:translate-x-0.5 before:translate-y-0.5 before:rounded-full before:bg-canvas-elevated before:shadow before:transition-transform checked:bg-ink checked:before:translate-x-[18px] checked:before:bg-on-primary"
										/>
									</label>
									<p class="mt-2 text-body-sm text-mute">
										Begins the output with "Lorem ipsum dolor sit amet…", the
										traditional opening line, before the rest of the generated text.
									</p>
								</div>

								<!-- Case selector -->
								<fieldset>
									<legend class="mb-2 block text-label-sm font-medium text-ink">Case</legend>
									<div class="grid grid-cols-4 gap-2" role="radiogroup" aria-label="Text case">
										{[
											{ value: "sentence", label: "Sentence", title: "Sentence case (natural)" },
											{ value: "lower", label: "lower", title: "lowercase" },
											{ value: "upper", label: "UPPER", title: "UPPERCASE" },
											{ value: "title", label: "Title", title: "Title Case" },
										].map((opt, i) => (
											<label
												title={opt.title}
												class="case-option flex cursor-pointer items-center justify-center rounded-sm border border-hairline bg-canvas-elevated px-1 py-2 text-center text-body-sm text-body transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-on-primary hover:border-faint"
											>
												<input
													type="radio"
													name="textCase"
													value={opt.value}
													checked={i === 0}
													aria-label={opt.title}
													class="sr-only"
												/>
												{opt.label}
											</label>
										))}
									</div>
								</fieldset>

								<!-- Format selector -->
								<fieldset>
									<legend class="mb-2 block text-label-sm font-medium text-ink">Export format</legend>
									<div class="grid grid-cols-3 gap-2" role="radiogroup" aria-label="Export format">
										{[{ value: "plain", label: "Plain" }, { value: "html", label: "HTML" }, { value: "markdown", label: "Markdown" }].map((fmt, i) => (
											<label
												class="format-option flex cursor-pointer items-center justify-center rounded-sm border border-hairline bg-canvas-elevated px-2 py-2 text-center text-body-sm text-body transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-on-primary hover:border-faint"
											>
												<input
													type="radio"
													name="format"
													value={fmt.value}
													checked={i === 0}
													class="sr-only"
												/>
												{fmt.label}
											</label>
										))}
									</div>
								</fieldset>
							</div>
						</details>
					</div>

					<!-- Output -->
					<div class="flex flex-col">
						<p class="mb-2 text-body-sm text-mute" id="output-caption">
							Example generated output (placeholder text, not real page content):
						</p>
						<div class="mb-2 flex items-center justify-between gap-3">
							<div class="flex items-center gap-4 text-body-sm text-mute tabular-nums" aria-live="polite">
								<span><strong id="word-count" class="text-ink">0</strong> words</span>
								<span><strong id="char-count" class="text-ink">0</strong> characters</span>
							</div>
							<button
								type="button"
								id="copy-button"
								class="flex items-center gap-1.5 rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-button-md text-ink transition-colors hover:bg-hairline-soft"
								aria-label="Copy generated text to clipboard"
							>
								<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
									<rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
									<path d="M11 5V3.5C11 2.67 10.33 2 9.5 2H3.5C2.67 2 2 2.67 2 3.5V9.5C2 10.33 2.67 11 3.5 11H5" stroke="currentColor" stroke-width="1.3"/>
								</svg>
								<span id="copy-button-label">Copy</span>
							</button>
						</div>

						<label for="output-area" class="sr-only">Generated placeholder text</label>
						<!-- Wrapper sizes both output views identically: the list view is
						     absolutely positioned so, like the textarea, it scrolls
						     internally instead of stretching the card. -->
						<div class="relative flex min-h-[320px] flex-1 flex-col">
							<textarea
								id="output-area"
								readonly
								autocomplete="off"
								spellcheck="false"
								class="min-h-[320px] flex-1 resize-none rounded-sm border border-hairline bg-canvas p-4 font-mono text-body-md text-ink focus-visible:outline-2 focus-visible:outline-link"
								aria-label="Generated placeholder text output"
								aria-describedby="output-caption"
							>{SAMPLE_OUTPUT}</textarea>

							<!-- Segmented view for paragraphs/sentences/titles/captions/names:
							     same text, plus a copy button per piece. -->
							<div
								id="output-list"
								role="region"
								tabindex="0"
								aria-label="Generated placeholder text output"
								hidden
								class="absolute inset-0 overflow-y-auto rounded-sm border border-hairline bg-canvas p-4 font-mono text-body-md text-ink wrap-break-word whitespace-pre-wrap focus-visible:outline-2 focus-visible:outline-link"
							></div>
						</div>

						<p class="sr-only" role="status" id="copy-status"></p>
					</div>
				</div>
			</form>
		</div>
	</div>
</section>

<script>
	import {
		generate,
		formatSegment,
		blockSeparator,
		type AmountUnit,
		type GenerateResult,
		type GeneratorTheme,
		type OutputFormat,
		type SegmentKind,
		type TextCase,
	} from "../lib/generator";
	import { THEMES } from "../lib/wordBanks";

	const form = document.getElementById("generator-form") as HTMLFormElement;
	const amountInput = document.getElementById("amount-input") as HTMLInputElement;
	const output = document.getElementById("output-area") as HTMLTextAreaElement;
	const outputList = document.getElementById("output-list") as HTMLDivElement;
	const moreOptions = document.getElementById("more-options") as HTMLDetailsElement;
	const startWithLoremInput = document.getElementById("start-with-lorem") as HTMLInputElement;
	const customField = document.getElementById("custom-text-field") as HTMLDivElement;
	const customTextInput = document.getElementById("custom-text") as HTMLTextAreaElement;
	const customHint = document.getElementById("custom-text-hint") as HTMLElement;
	const CUSTOM_HINT_DEFAULT = customHint.textContent?.replace(/\s+/g, " ").trim() ?? "";
	const wordCountEl = document.getElementById("word-count") as HTMLElement;
	const charCountEl = document.getElementById("char-count") as HTMLElement;
	const copyButton = document.getElementById("copy-button") as HTMLButtonElement;
	const copyLabel = document.getElementById("copy-button-label") as HTMLElement;
	const copyStatus = document.getElementById("copy-status") as HTMLElement;
	const amountStatus = document.getElementById("amount-status") as HTMLElement;

	// Custom "unit" listbox (replaces a native <select> to avoid inconsistent
	// popup positioning across browsers/devices) backed by a hidden input.
	const unitTrigger = document.getElementById("unit-select-trigger") as HTMLButtonElement;
	const unitListbox = document.getElementById("unit-select-listbox") as HTMLUListElement;
	const unitLabel = document.getElementById("unit-select-label") as HTMLElement;
	const unitHiddenInput = document.getElementById("unit-select") as HTMLInputElement;
	const unitOptions = Array.from(unitListbox.querySelectorAll<HTMLLIElement>('[role="option"]'));

	function closeUnitListbox() {
		unitListbox.hidden = true;
		unitTrigger.setAttribute("aria-expanded", "false");
	}

	function openUnitListbox() {
		unitListbox.hidden = false;
		unitTrigger.setAttribute("aria-expanded", "true");
		const selected = unitOptions.find((opt) => opt.getAttribute("aria-selected") === "true");
		selected?.focus();
	}

	/** Reflect a unit choice in the listbox, trigger label, and hidden input. */
	function setUnitUI(option: HTMLLIElement) {
		unitOptions.forEach((opt) => opt.setAttribute("aria-selected", String(opt === option)));
		unitLabel.textContent = option.textContent?.trim() ?? "";
		unitHiddenInput.value = option.dataset.value ?? "paragraphs";
	}

	function selectUnitOption(option: HTMLLIElement) {
		const value = option.dataset.value ?? "paragraphs";
		setUnitUI(option);
		applyAmountConstraints(value);
		unitHiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
		closeUnitListbox();
		unitTrigger.focus();
	}

	// Each unit has a sensible amount range/default so a unit switch can't
	// leave the input holding an out-of-range or nonsensical value (e.g. 500
	// paragraphs, or 5 characters).
	const AMOUNT_CONSTRAINTS: Record<string, { min: number; max: number; default: number }> = {
		paragraphs: { min: 1, max: 50, default: 5 },
		sentences: { min: 1, max: 50, default: 5 },
		words: { min: 1, max: 200, default: 50 },
		characters: { min: 1, max: 5000, default: 500 },
		titles: { min: 1, max: 50, default: 5 },
		captions: { min: 1, max: 50, default: 5 },
		names: { min: 1, max: 100, default: 10 },
	};

	function applyAmountConstraints(unit: string) {
		const constraints = AMOUNT_CONSTRAINTS[unit] ?? AMOUNT_CONSTRAINTS.paragraphs;
		amountInput.min = String(constraints.min);
		amountInput.max = String(constraints.max);

		const current = Number(amountInput.value);
		if (!current || current < constraints.min || current > constraints.max) {
			amountInput.value = String(constraints.default);
			amountStatus.textContent = `Amount reset to ${constraints.default} — valid range for ${unit} is ${constraints.min}\u2013${constraints.max}.`;
		} else {
			amountStatus.textContent = "";
		}
	}

	unitTrigger.addEventListener("click", () => {
		if (unitListbox.hidden) {
			openUnitListbox();
		} else {
			closeUnitListbox();
		}
	});

	// Catch out-of-range values typed directly into the amount field (not
	// just ones left stale after a unit switch), and tell the user what happened.
	amountInput.addEventListener("blur", () => {
		applyAmountConstraints(unitHiddenInput.value);
	});

	unitOptions.forEach((option) => {
		option.setAttribute("tabindex", "-1");
		option.addEventListener("click", () => selectUnitOption(option));
	});

	unitListbox.addEventListener("keydown", (e) => {
		const currentIndex = unitOptions.findIndex((opt) => opt === document.activeElement);
		if (e.key === "ArrowDown") {
			e.preventDefault();
			const next = unitOptions[Math.min(currentIndex + 1, unitOptions.length - 1)];
			next.focus();
		} else if (e.key === "ArrowUp") {
			e.preventDefault();
			const prev = unitOptions[Math.max(currentIndex - 1, 0)];
			prev.focus();
		} else if (e.key === "Enter" || e.key === " ") {
			e.preventDefault();
			const active = unitOptions[currentIndex];
			if (active) selectUnitOption(active);
		} else if (e.key === "Escape") {
			e.preventDefault();
			closeUnitListbox();
			unitTrigger.focus();
		} else if (e.key === "Tab") {
			closeUnitListbox();
		}
	});

	document.addEventListener("click", (e) => {
		if (!unitListbox.hidden && !e.composedPath().includes(document.getElementById("unit-dropdown")!)) {
			closeUnitListbox();
		}
	});

	// ------------------------------------------------------------------
	// Remember last-used settings (localStorage)
	// ------------------------------------------------------------------
	// Everything is wrapped in try/catch: storage can be missing, disabled,
	// full, or throw on access (e.g. some private-browsing modes). Any failure
	// silently falls back to the defaults already rendered in the markup.

	const SETTINGS_KEY = "loremmaker:generator-settings";
	const SETTINGS_VERSION = 1;

	// Note: pasted/typed custom text is deliberately excluded from this shape
	// and is never written to storage — only the generator's control settings
	// are remembered.
	interface GeneratorSettings {
		unit: AmountUnit;
		amount: number;
		theme: GeneratorTheme;
		format: OutputFormat;
		textCase: TextCase;
		startWithLorem: boolean;
	}

	const VALID_UNITS = Object.keys(AMOUNT_CONSTRAINTS) as AmountUnit[];
	const VALID_THEMES = [...Object.keys(THEMES), "custom"] as GeneratorTheme[];
	const VALID_FORMATS: OutputFormat[] = ["plain", "html", "markdown"];
	const VALID_CASES: TextCase[] = ["sentence", "lower", "upper", "title"];

	function oneOf<T extends string>(value: unknown, allowed: readonly T[]): T | undefined {
		return typeof value === "string" && (allowed as readonly string[]).includes(value) ? (value as T) : undefined;
	}

	function loadSettings(): Partial<GeneratorSettings> | null {
		try {
			const raw = window.localStorage.getItem(SETTINGS_KEY);
			if (!raw) return null;
			const data = JSON.parse(raw);
			if (!data || typeof data !== "object" || data.v !== SETTINGS_VERSION) return null;
			// Validate each field independently so one bad value doesn't
			// discard the rest.
			return {
				unit: oneOf(data.unit, VALID_UNITS),
				amount: Number.isFinite(data.amount) ? Math.floor(data.amount) : undefined,
				theme: oneOf(data.theme, VALID_THEMES),
				format: oneOf(data.format, VALID_FORMATS),
				textCase: oneOf(data.textCase, VALID_CASES),
				startWithLorem: typeof data.startWithLorem === "boolean" ? data.startWithLorem : undefined,
			};
		} catch {
			return null;
		}
	}

	function saveSettings(settings: GeneratorSettings) {
		try {
			window.localStorage.setItem(SETTINGS_KEY, JSON.stringify({ v: SETTINGS_VERSION, ...settings }));
		} catch {
			// Storage unavailable or full — persistence is best-effort.
		}
	}

	function checkRadio(name: string, value: string | undefined) {
		if (!value) return;
		const radio = form.querySelector<HTMLInputElement>(`input[type="radio"][name="${name}"][value="${value}"]`);
		if (radio) radio.checked = true;
	}

	function restoreSettings() {
		const saved = loadSettings();
		if (!saved) return;

		if (saved.unit) {
			const option = unitOptions.find((opt) => opt.dataset.value === saved.unit);
			if (option) setUnitUI(option);
		}
		const constraints = AMOUNT_CONSTRAINTS[unitHiddenInput.value] ?? AMOUNT_CONSTRAINTS.paragraphs;
		amountInput.min = String(constraints.min);
		amountInput.max = String(constraints.max);
		const amountValid =
			saved.amount !== undefined && saved.amount >= constraints.min && saved.amount <= constraints.max;
		amountInput.value = String(amountValid ? saved.amount : constraints.default);

		checkRadio("theme", saved.theme);
		checkRadio("format", saved.format);
		checkRadio("textCase", saved.textCase);
		if (saved.startWithLorem !== undefined) startWithLoremInput.checked = saved.startWithLorem;

		// The custom textarea lives inside "More options"; open it so a
		// returning Custom user immediately sees where to paste their text
		// again (its previous content is never remembered).
		if (saved.theme === "custom") moreOptions.open = true;
	}

	// ------------------------------------------------------------------
	// Copy helpers (shared by the main Copy button and per-piece buttons)
	// ------------------------------------------------------------------

	const COPY_ICON = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M11 5V3.5C11 2.67 10.33 2 9.5 2H3.5C2.67 2 2 2.67 2 3.5V9.5C2 10.33 2.67 11 3.5 11H5" stroke="currentColor" stroke-width="1.3"/></svg>`;
	const CHECK_ICON = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
	const COPIED_RESET_MS = 1800;

	/**
	 * Copy text via the Clipboard API, falling back to execCommand on a
	 * temporary off-screen textarea. Resolves to whether the copy succeeded —
	 * execCommand returns a boolean we must check, since announcing success
	 * unconditionally would tell screen-reader users the copy worked when it
	 * didn't.
	 */
	async function copyText(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const previousFocus = document.activeElement as HTMLElement | null;
			const scratch = document.createElement("textarea");
			scratch.value = text;
			scratch.setAttribute("readonly", "");
			scratch.style.position = "fixed";
			scratch.style.top = "0";
			scratch.style.opacity = "0";
			scratch.style.pointerEvents = "none";
			document.body.append(scratch);
			scratch.select();
			let succeeded = false;
			try {
				succeeded = document.execCommand("copy");
			} catch {
				succeeded = false;
			}
			scratch.remove();
			previousFocus?.focus({ preventScroll: true });
			return succeeded;
		}
	}

	function announceCopyFailure() {
		copyStatus.textContent = "Copy failed. Select the text and copy it manually.";
	}

	// ------------------------------------------------------------------
	// Output rendering
	// ------------------------------------------------------------------

	/** Full formatted text currently shown — what the main Copy button copies. */
	let currentText = "";

	function makeSegmentCopyButton(text: string, kind: SegmentKind, index: number, inline: boolean) {
		const label = `Copy ${kind} ${index + 1}`;
		const button = document.createElement("button");
		button.type = "button";
		button.title = label;
		button.setAttribute("aria-label", label);
		// after:-inset-1 extends the hit area beyond the 20px visual box.
		button.className =
			"relative inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-xs text-faint transition-colors after:absolute after:-inset-1 hover:bg-hairline-soft hover:text-ink focus-visible:text-ink" +
			(inline ? " ml-1 align-[-4px]" : "");
		button.innerHTML = COPY_ICON;

		let resetTimer: ReturnType<typeof setTimeout> | undefined;
		button.addEventListener("click", async () => {
			if (!(await copyText(text))) {
				announceCopyFailure();
				return;
			}
			const kindLabel = kind.charAt(0).toUpperCase() + kind.slice(1);
			button.innerHTML = CHECK_ICON;
			button.classList.add("text-ink");
			button.setAttribute("aria-label", `${kindLabel} ${index + 1} copied`);
			copyStatus.textContent = `${kindLabel} ${index + 1} copied to clipboard`;
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				button.innerHTML = COPY_ICON;
				button.classList.remove("text-ink");
				button.setAttribute("aria-label", label);
			}, COPIED_RESET_MS);
		});

		return button;
	}

	function showTextarea(text: string) {
		output.value = text;
		output.hidden = false;
		outputList.hidden = true;
		outputList.replaceChildren();
	}

	function showList(children: Node[]) {
		output.hidden = true;
		outputList.hidden = false;
		outputList.replaceChildren(...children);
		outputList.scrollTop = 0;
	}

	function renderOutput(result: GenerateResult, format: OutputFormat) {
		currentText = result.text;
		output.value = result.text;
		wordCountEl.textContent = result.wordCount.toLocaleString();
		charCountEl.textContent = result.characterCount.toLocaleString();

		if (result.error) {
			const message = document.createElement("p");
			message.className = "font-sans text-body-md text-mute";
			message.textContent = result.error;
			showList([message]);
			return;
		}

		const kind = result.segmentKind;
		if (!kind) {
			// Words / characters: a single block, shown exactly as before.
			showTextarea(result.text);
			return;
		}

		if (kind === "sentence") {
			// Sentences form one paragraph in the exported text, so they stay
			// inline here too, each followed by its own small copy button.
			const block = document.createElement("div");
			if (format === "html") block.append("<p>");
			result.segments.forEach((sentence, i) => {
				if (i > 0) block.append(" ");
				const span = document.createElement("span");
				span.textContent = sentence;
				block.append(span, makeSegmentCopyButton(sentence, kind, i, true));
			});
			if (format === "html") block.append("</p>");
			showList([block]);
			return;
		}

		// Block segments (paragraphs, titles, captions, names): one row each,
		// spaced to mirror the blank-line / single-line separators in `text`.
		const gapClass = blockSeparator(kind, format) === "\n\n" ? "mt-5" : "mt-1";
		const rows = result.segments.map((segment, i) => {
			const formatted = formatSegment(segment, format);
			const row = document.createElement("div");
			row.className = "flex items-start gap-3" + (i > 0 ? ` ${gapClass}` : "");
			const text = document.createElement("div");
			text.className = "min-w-0 flex-1";
			text.textContent = formatted;
			row.append(text, makeSegmentCopyButton(formatted, kind, i, false));
			return row;
		});
		showList(rows);
	}

	// ------------------------------------------------------------------
	// Generation
	// ------------------------------------------------------------------

	function syncCustomField(theme: GeneratorTheme, error?: string) {
		customField.hidden = theme !== "custom";
		customHint.textContent = theme === "custom" && error ? error : CUSTOM_HINT_DEFAULT;
		customHint.classList.toggle("text-ink", Boolean(theme === "custom" && error));
		customHint.classList.toggle("text-mute", !(theme === "custom" && error));
	}

	function runGenerate({ persist = true }: { persist?: boolean } = {}) {
		const formData = new FormData(form);
		const theme = (formData.get("theme") as GeneratorTheme) ?? "tech";
		const unit = (formData.get("unit") as AmountUnit) ?? "paragraphs";
		const format = (formData.get("format") as OutputFormat) ?? "plain";
		const textCase = (formData.get("textCase") as TextCase) ?? "sentence";
		const amount = Number(formData.get("amount")) || 5;
		const startWithLorem = formData.get("startWithLorem") === "on";
		const customText = customTextInput.value;

		const result = generate({ theme, unit, amount, startWithLorem, format, textCase, customText });

		renderOutput(result, format);
		syncCustomField(theme, result.error);

		if (persist) {
			saveSettings({ unit, amount, theme, format, textCase, startWithLorem });
		}
	}

	form.addEventListener("submit", (e) => {
		e.preventDefault();
		runGenerate();
	});

	// Live-regenerate on control change for instant feedback (no need to click Generate).
	form.addEventListener("change", (e) => {
		// The custom textarea already regenerates on (debounced) input; its
		// blur-time "change" would otherwise swap the output under the user
		// as they move to click Copy.
		if (e.target === customTextInput) return;
		runGenerate();
	});

	let customInputTimer: ReturnType<typeof setTimeout> | undefined;
	customTextInput.addEventListener("input", () => {
		clearTimeout(customInputTimer);
		customInputTimer = setTimeout(() => runGenerate(), 250);
	});

	// Keyboard shortcut: Cmd/Ctrl+Enter to regenerate from anywhere in the form.
	form.addEventListener("keydown", (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
			e.preventDefault();
			runGenerate();
		}
	});

	let mainCopyResetTimer: ReturnType<typeof setTimeout> | undefined;
	copyButton.addEventListener("click", async () => {
		if (!currentText) return;

		if (await copyText(currentText)) {
			copyLabel.textContent = "Copied!";
			copyStatus.textContent = "Text copied to clipboard";
			clearTimeout(mainCopyResetTimer);
			mainCopyResetTimer = setTimeout(() => {
				copyLabel.textContent = "Copy";
			}, COPIED_RESET_MS);
		} else {
			announceCopyFailure();
		}
	});

	// Restore last-used settings (if any), then do the initial generation.
	// The initial render doesn't write to storage, so a first-time visitor
	// who never touches the controls leaves nothing behind.
	restoreSettings();
	runGenerate({ persist: false });
</script>
