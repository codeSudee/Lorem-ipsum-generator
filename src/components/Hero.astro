---
---

<section class="relative overflow-hidden border-b border-hairline bg-canvas">
	<!-- Mesh gradient — the hero's only decorative flourish -->
	<div
		class="pointer-events-none absolute inset-0 -z-10 opacity-60"
		aria-hidden="true"
	>
		<div
			class="absolute -top-32 left-1/2 h-[500px] w-[900px] -translate-x-1/2 rounded-full blur-[100px]"
			style="background: conic-gradient(from 180deg at 50% 50%, #50e3c2, #0070f3, #7928ca, #ff0080, #f5a623, #50e3c2);"
		>
		</div>
	</div>
	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-canvas/60"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-[1200px] px-6 pt-24 pb-20 text-center sm:pt-32 sm:pb-28">
		<p class="mono-eyebrow mb-4 inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-3 py-1 text-mute">
			<span class="h-1.5 w-1.5 rounded-full bg-cyan" aria-hidden="true"></span>
			Free &amp; instant placeholder text
		</p>

		<h1 class="text-pretty text-display-xl text-ink sm:text-[64px] sm:leading-[64px] sm:tracking-[-3.2px]">
			Lorem Ipsum Generator
		</h1>

		<p class="mx-auto mt-6 max-w-2xl text-pretty text-body-lg text-body">
			Free Lorem Ipsum generator for paragraphs, sentences, and words —
			even an exact character count. Generate classic <em>lorem ipsum dolor sit amet</em>{" "}
			text or themed placeholder copy — Corporate, Tech, Foodie, Cat, and a funny
			lorem ipsum option — then copy it instantly as plain text, HTML, or Markdown.
		</p>

		<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a
				href="/#generator"
				class="rounded-pill bg-ink px-[14px] py-2.5 text-button-lg font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				Start Generating
			</a>
			<a
				href="/#themes"
				class="rounded-pill border border-hairline bg-canvas-elevated px-[14px] py-2.5 text-button-lg font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Explore Themes
			</a>
		</div>

		<nav class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2" aria-label="More pages">
			<a href="/about" class="text-body-sm text-mute transition-colors hover:text-ink">About Us</a>
			<a href="/contact" class="text-body-sm text-mute transition-colors hover:text-ink">Contact Us</a>
			<a href="/privacy-policy" class="text-body-sm text-mute transition-colors hover:text-ink">Privacy Policy</a>
			<a href="/terms" class="text-body-sm text-mute transition-colors hover:text-ink">Terms &amp; Conditions</a>
		</nav>
	</div>
</section>
