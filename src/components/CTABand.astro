---
---

<section class="relative overflow-hidden border-b border-hairline bg-canvas">
	<!-- Faint echo of the hero's mesh gradient — bookends the page. -->
	<div
		class="pointer-events-none absolute inset-0 -z-10 opacity-30"
		aria-hidden="true"
	>
		<div
			class="absolute -bottom-40 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full blur-[100px]"
			style="background: conic-gradient(from 180deg at 50% 50%, #50e3c2, #0070f3, #7928ca, #ff0080, #f5a623, #50e3c2);"
		>
		</div>
	</div>

	<div class="relative mx-auto max-w-[1200px] px-6 py-24 text-center sm:py-32">
		<h2 class="text-pretty text-heading-lg text-ink sm:text-display-xl">
			Need placeholder text? Generate it now.
		</h2>
		<p class="mx-auto mt-4 max-w-xl text-pretty text-body-lg text-body">
			Pick a word bank, set your length, and copy — free, instant, no sign-up.
		</p>
		<div class="mt-8">
			<a
				href="/#generator"
				class="inline-flex items-center justify-center rounded-pill bg-ink px-[14px] py-2.5 text-button-lg font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				Generate Text
			</a>
		</div>
	</div>
</section>
