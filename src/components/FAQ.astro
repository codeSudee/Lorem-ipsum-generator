---
import { FAQS } from "../lib/faqs";

const faqs = FAQS;
---

<section id="faq" class="border-b border-hairline bg-canvas py-20 sm:py-28">
	<div class="mx-auto max-w-[800px] px-6">
		<div class="mb-10 text-center">
			<p class="mono-eyebrow mb-3 text-mute">Good to know</p>
			<h2 class="text-heading-lg text-pretty text-ink">Frequently asked questions</h2>
		</div>

		<div class="flex flex-col gap-3">
			{faqs.map((item, i) => (
				<details
					class="group rounded-md border border-hairline bg-canvas-elevated p-5 open:pb-5"
					open={i === 0}
				>
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-heading-md text-ink marker:content-none">
						{item.q}
						<span
							class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-body-md text-mute transition-transform group-open:rotate-45"
							aria-hidden="true"
						>
							+
						</span>
					</summary>
					<p class="mt-3 text-body-md text-body" set:html={item.a} />
				</details>
			))}
		</div>
	</div>
</section>
