---
import { LANDING_PAGES } from "../lib/landingPages";
---

<section id="popular" class="border-b border-hairline bg-canvas py-20 sm:py-28">
	<div data-scroll-reveal class="mx-auto max-w-[1200px] px-6">
		<div class="mx-auto mb-10 max-w-2xl text-center">
			<p class="mono-eyebrow mb-3 text-mute">Ready-made presets</p>
			<h2 class="text-heading-lg text-pretty text-ink">Popular generators</h2>
			<p class="mt-3 text-body-lg text-body">
				Jump straight to a common length or style, already configured.
			</p>
		</div>

		<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{LANDING_PAGES.map((page) => (
				<li>
					<a
						href={`/${page.slug}`}
						class="block h-full rounded-md border border-hairline bg-canvas-elevated p-5 transition-colors hover:bg-hairline-soft"
					>
						<h3 class="text-heading-md text-ink">{page.label}</h3>
						<p class="mt-2 text-body-sm text-body">{page.intro.split(". ")[0]}.</p>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
