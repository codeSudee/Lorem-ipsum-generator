---
const features = [
	{
		title: "Instant, no page reload",
		body: "Every control updates the output live — no submit-and-wait round trip.",
	},
	{
		title: "Six word banks, not one",
		body: "Classic Latin plus Corporate, Tech/Startup, Foodie, Cat, and Funny vocabularies — pick the tone that fits your mockup.",
	},
	{
		title: "Export-ready formats",
		body: "Copy as Plain Text, HTML wrapped in <p> tags, or Markdown — paste straight into your project.",
	},
	{
		title: "Live counts",
		body: "Word and character counts update as you type or toggle settings, so you can hit exact length targets.",
	},
	{
		title: "One-click copy",
		body: "A single Copy button with clipboard-API support and a visible confirmation state — no manual select-all.",
	},
	{
		title: "Keyboard-first",
		body: "Press ⌘/Ctrl + Enter to regenerate without touching the mouse.",
	},
];
---

<section class="border-b border-hairline bg-hairline-soft py-20 sm:py-28">
	<div class="mx-auto max-w-[1200px] px-6">
		<div class="mx-auto mb-10 max-w-2xl text-center">
			<p class="mono-eyebrow mb-3 text-mute">Built to be better</p>
			<h2 class="text-heading-lg text-pretty text-ink">
				Everything you need from a Lorem Ipsum generator
			</h2>
			<p class="mt-3 text-body-lg text-body">
				A fast, no-nonsense generator built for how people actually work today.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{features.map((f) => (
				<div class="rounded-md border border-hairline bg-canvas-elevated p-6">
					<h3 class="text-heading-md text-ink">{f.title}</h3>
					<p class="mt-2 text-body-md text-body">{f.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
